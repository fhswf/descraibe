# ── Audiodeskription Frontend Docker Image ─────────────────────────────────────
#
# Two-stage build:
#   1. node:24-slim   – builds the Vite/React app
#   2. nginx:alpine   – serves the static dist/ with SPA fallback
#
# Build:
#   docker build -f Dockerfile.frontend -t audiodeskription-frontend .
#
# All /api/* traffic is routed directly to the backend by Traefik.
# This image only ever serves /, /assets/*, and the index.html SPA fallback.

# ── Stage 1: Build ─────────────────────────────────────────────────────────────
FROM node:24-slim AS frontend-builder
WORKDIR /app/frontend

ARG VITE_APP_BUILD_CHANNEL=""
ARG VITE_APP_COMMIT_SHA=""
ARG VITE_APP_REPOSITORY_URL=""

COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

# ── Stage 2: Serve ─────────────────────────────────────────────────────────────
FROM nginx:alpine

# Remove the default nginx config
RUN rm /etc/nginx/conf.d/default.conf

COPY docker/nginx.conf /etc/nginx/conf.d/frontend.conf

COPY --from=frontend-builder /app/frontend/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
