   "source": [
    "\n",
    "######################################################\n",
    "# \n",
    "# Funktionen zum mergen der .srt Dateien\n",
    "# ChatGPT\n",
    "\n",
    "TIME_RE = re.compile(\n",
    "    r\"(?P<h>\\d{2}):(?P<m>\\d{2}):(?P<s>\\d{2}),(?P<ms>\\d{3})\"\n",
    ")\n",
    "\n",
    "def _parse_time(t: str) -> float:\n",
    "    m = TIME_RE.match(t.strip())\n",
    "    assert m, f\"Ungültiger Zeitstempel: {t}\"\n",
    "    return (\n",
    "        int(m.group(\"h\")) * 3600\n",
    "        + int(m.group(\"m\")) * 60\n",
    "        + int(m.group(\"s\"))\n",
    "        + int(m.group(\"ms\")) / 1000.0\n",
    "    )\n",
    "\n",
    "def _fmt_time(sec: float) -> str:\n",
    "    ms_total = int(round(sec * 1000))\n",
    "    s, ms = divmod(ms_total, 1000)\n",
    "    m, s = divmod(s, 60)\n",
    "    h, m = divmod(m, 60)\n",
    "    return f\"{h:02d}:{m:02d}:{s:02d},{ms:03d}\"\n",
    "\n",
    "def _parse_srt(path: str) -> List[Dict]:\n",
    "    with open(path, \"r\", encoding=\"utf-8\") as f:\n",
    "        content = f.read()\n",
    "\n",
    "    # Blöcke durch Leerzeile getrennt\n",
    "    raw_blocks = [b for b in re.split(r\"\\n\\s*\\n\", content) if b.strip()]\n",
    "    entries = []\n",
    "    for block in raw_blocks:\n",
    "        lines = [l for l in block.splitlines() if l.strip() != \"\" or True]\n",
    "        if not lines:\n",
    "            continue\n",
    "\n",
    "        # 1. (optional) Nummer\n",
    "        i = 0\n",
    "        if re.fullmatch(r\"\\d+\", lines[0].strip()):\n",
    "            i = 1  # nächste Zeile ist Zeit\n",
    "        # 2. Zeitzeile\n",
    "        times = lines[i].split(\"-->\")\n",
    "        if len(times) != 2:\n",
    "            # manche SRTs haben BOM/Leerzeilen – defensiv sein\n",
    "            raise ValueError(f\"Keine gültige Zeitzeile:\\n{lines[i]}\")\n",
    "        start = _parse_time(times[0])\n",
    "        end = _parse_time(times[1])\n",
    "        # 3. Rest = Text (kann mehrzeilig sein)\n",
    "        text = \"\\n\".join(lines[i+1:]).strip()\n",
    "        entries.append({\"start\": start, \"end\": end, \"text\": text})\n",
    "    return entries\n",
    "\n",
    "def _write_srt(entries: List[Dict], out_path: str) -> str:\n",
    "    with open(out_path, \"w\", encoding=\"utf-8\") as f:\n",
    "        for idx, e in enumerate(entries, start=1):\n",
    "            f.write(f\"{idx}\\n\")\n",
    "            f.write(f\"{_fmt_time(e['start'])} --> {_fmt_time(e['end'])}\\n\")\n",
    "            f.write(f\"{e['text'].rstrip()}\\n\\n\")\n",
    "    return out_path\n",
    "\n",
    "def _overlap(a: Tuple[float, float], b: Tuple[float, float]) -> float:\n",
    "    return max(0.0, min(a[1], b[1]) - max(a[0], b[0]))\n",
    "\n",
    "def merge_srt(\n",
    "    srt_path_a: str,\n",
    "    srt_path_b: str,\n",
    "    out_path: str,\n",
    "    *,\n",
    "    label_a: str = \"[A]\",\n",
    "    label_b: str = \"[B]\",\n",
    "    separator_line: str = \"———\",\n",
    "    overlap_epsilon: float = 1e-3\n",
    ") -> str:\n",
    "    \"\"\"\n",
    "    Führt zwei SRT-Dateien zu einer zusammen.\n",
    "    - Alle Cues werden zeitlich sortiert.\n",
    "    - Bei Überlappungen werden die Texte in EINEM Cue kombiniert,\n",
    "      getrennt durch 'separator_line' und mit Labels gekennzeichnet.\n",
    "      Der kombinierte Cue nutzt die *Vereinigung* des Zeitfensters.\n",
    "\n",
    "    Args:\n",
    "        srt_path_a, srt_path_b: Eingabe-SRTs\n",
    "        out_path: Ziel-SRT\n",
    "        label_a, label_b: Präfixe für Text aus Datei A bzw. B\n",
    "        separator_line: Trennzeile zwischen beiden Texten\n",
    "        overlap_epsilon: Toleranz in Sekunden für Überlappungen\n",
    "\n",
    "    Returns:\n",
    "        Pfad zur geschriebenen SRT.\n",
    "    \"\"\"\n",
    "    A = _parse_srt(srt_path_a)\n",
    "    B = _parse_srt(srt_path_b)\n",
    "\n",
    "    # Quelle kennzeichnen\n",
    "    for e in A:\n",
    "        e[\"src\"] = \"A\"\n",
    "    for e in B:\n",
    "        e[\"src\"] = \"B\"\n",
    "\n",
    "    all_entries = sorted(A + B, key=lambda e: (e[\"start\"], e[\"end\"]))\n",
    "\n",
    "    merged: List[Dict] = []\n",
    "    i = 0\n",
    "    n = len(all_entries)\n",
    "\n",
    "    while i < n:\n",
    "        # Starte neue Gruppe mit aktuellem Fenster\n",
    "        cur = all_entries[i]\n",
    "        group = [cur]\n",
    "        g_start = cur[\"start\"]\n",
    "        g_end = cur[\"end\"]\n",
    "        i += 1\n",
    "\n",
    "        # Sammle alle Einträge, die (zeitlich) mit der Gruppe überlappen\n",
    "        while i < n:\n",
    "            cand = all_entries[i]\n",
    "            if _overlap((g_start, g_end), (cand[\"start\"], cand[\"end\"])) > overlap_epsilon \\\n",
    "               or (cand[\"start\"] <= g_end + overlap_epsilon and cand[\"start\"] >= g_start - overlap_epsilon):\n",
    "                group.append(cand)\n",
    "                g_start = min(g_start, cand[\"start\"])\n",
    "                g_end = max(g_end, cand[\"end\"])\n",
    "                i += 1\n",
    "            else:\n",
    "                break\n",
    "\n",
    "        # Gruppe auswerten\n",
    "        if len(group) == 1:\n",
    "            e = group[0]\n",
    "            pref = label_a if e[\"src\"] == \"A\" else label_b\n",
    "            merged.append({\n",
    "                \"start\": e[\"start\"],\n",
    "                \"end\": e[\"end\"],\n",
    "                \"text\": f\"{pref} {e['text']}\".strip()\n",
    "            })\n",
    "        else:\n",
    "            # Konflikt: kombiniere Texte, trenne sichtbar\n",
    "            parts = []\n",
    "            # Reihenfolge innerhalb der Gruppe: erst A dann B (stabil sortiert nach Start)\n",
    "            for src in (\"A\", \"B\"):\n",
    "                texts = [e[\"text\"] for e in group if e[\"src\"] == src]\n",
    "                if texts:\n",
    "                    pref = label_a if src == \"A\" else label_b\n",
    "                    # Mehrere aus derselben Quelle in der Gruppe zusammenfassen\n",
    "                    combined = (\"\\n\").join(texts).strip()\n",
    "                    parts.append(f\"{pref} {combined}\")\n",
    "            text = f\"\\n{separator_line}\\n\".join(parts)\n",
    "            merged.append({\n",
    "                \"start\": g_start,\n",
    "                \"end\": g_end,\n",
    "                \"text\": text\n",
    "            })\n",
    "\n",
    "    return _write_srt(merged, out_path)\n",
    "\n",
    "\n"
   ]
  },
