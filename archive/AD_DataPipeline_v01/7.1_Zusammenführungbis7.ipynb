    "    \"\"\"\n",
    "    print(\"Dieser Vorgang kann einige Minuten dauern! Je nach GPU oder CPU ca. bis zu 50x Videolänge\")\n",
    "    confirm = input(\"Möchtest du fortfahren? (Y zum Bestätigen): \").strip().lower()\n",
