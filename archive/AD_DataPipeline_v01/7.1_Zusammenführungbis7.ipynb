    "######################################################\n",
    "# \n",
    "# Funktionen zum speichern der Sprechpausen im .srt Format\n",
    "# ChatGPT \n",
    "\n",
    "\n",
    "def _secs_to_srt_time(t: float) -> str:\n",
    "    \"\"\"Konvertiert Sekunden (float) nach SRT-Zeitstempel HH:MM:SS,mmm.\"\"\"\n",
    "    # Runden auf Millisekunden und sauber überlaufen lassen\n",
    "    ms_total = int(round(t * 1000))\n",
    "    seconds, ms = divmod(ms_total, 1000)\n",
    "    minutes, sec = divmod(seconds, 60)\n",
    "    hours, minute = divmod(minutes, 60)\n",
    "    return f\"{hours:02d}:{minute:02d}:{sec:02d},{ms:03d}\"\n",
    "\n",
    "\n",
    "def pauses_to_srt(\n",
    "    intervals: List[Dict[str, float]],\n",
    "    out_path: str,\n",
    "    label: str = \"[PAUSE]\",\n",
    "    min_duration: Optional[float] = None,\n",
    "    sort_intervals: bool = True\n",
    ") -> str:\n",
    "    \"\"\"\n",
    "    Speichert Sprechpausen als .srt-Untertitel.\n",
    "\n",
    "    Args:\n",
    "        intervals: Liste von Dicts mit Schlüsseln 'start', 'end', 'duration' (Sekunden).\n",
    "        out_path: Pfad zur .srt-Datei.\n",
    "        label: Text, der in jeder Pause angezeigt wird (z. B. \"[PAUSE]\").\n",
    "        min_duration: Optional. Pausen kürzer als dieser Wert (Sek.) werden gefiltert.\n",
    "        sort_intervals: Optional. True = nach Startzeit sortieren.\n",
    "\n",
    "    Returns:\n",
    "        Pfad zur geschriebenen .srt-Datei.\n",
    "    \"\"\"\n",
    "    if not intervals:\n",
    "        # Leere Datei schreiben, falls keine Pausen vorhanden\n",
    "        open(out_path, \"w\", encoding=\"utf-8\").close()\n",
    "        return out_path\n",
    "\n",
    "    items = intervals\n",
    "    if sort_intervals:\n",
    "        items = sorted(items, key=lambda x: x[\"start\"])\n",
    "\n",
    "    if min_duration is not None:\n",
    "        items = [it for it in items if it.get(\"duration\", (it[\"end\"] - it[\"start\"])) >= min_duration]\n",
    "\n",
    "    with open(out_path, \"w\", encoding=\"utf-8\") as f:\n",
    "        for idx, it in enumerate(items, start=1):\n",
    "            start = float(it[\"start\"])\n",
    "            end = float(it[\"end\"])\n",
    "            dur = float(it.get(\"duration\", end - start))\n",
    "            f.write(f\"{idx}\\n\")\n",
    "            f.write(f\"{_secs_to_srt_time(start)} --> {_secs_to_srt_time(end)}\\n\")\n",
    "            f.write(f\"{label} ({dur:.1f}s)\\n\\n\")\n",
    "\n",
    "    return out_path"
   ]
  },
